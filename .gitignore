# Environment / secrets
.env
.env.*
!.env.example

# Data is DVC-tracked, not git-tracked. DVC manages its own nested .gitignore
# entries under /data/ (created by `dvc add`) to exclude the raw content while
# still letting git track the *.dvc metadata files and the local DVC remote.
/dvc-storage/

# ML experiment tracking
mlruns/

# DVC cache
.dvc/cache

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/
.python-version

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
