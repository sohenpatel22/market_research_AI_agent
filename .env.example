# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider: deepseek (default) | openai | anthropic. Only the chosen provider's key is needed.
LLM_PROVIDER=deepseek
# Leave blank to use the provider default model (see llm/factory.py).
LLM_MODEL=
DEEPSEEK_API_KEY=changeme
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: use a different provider/model as the LLM judge for grading and evals.
JUDGE_PROVIDER=
JUDGE_MODEL=

# Connection string for the application database (matches docker-compose.yml defaults).
DATABASE_URL=postgresql+psycopg://market_research_agent:market_research_agent@localhost:5433/market_research_agent

# SEC EDGAR requires a descriptive User-Agent identifying you/your app (see
# https://www.sec.gov/os/webmaster-faq#developers). Replace with your own contact info.
SEC_EDGAR_USER_AGENT=Market Research Agent you@example.com

# Local Hugging Face sentence-transformer used for embedding filing text chunks.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5

# MLflow tracking store for model training runs.
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Optional: cache identical LLM calls on disk (great for eval reruns; keep off for live traffic).
LLM_CACHE=false
